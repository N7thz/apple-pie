generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id @default(uuid())
  title     String   @unique
  content   String   
  taskDay   DateTime @map("task_day")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isChecked Boolean  @default(false)
  priority  Priority @default(LOW) @map("priority")

  @@map("tasks")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
